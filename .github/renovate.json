{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":preserveSemverRanges",
    ":automergeMinor",
    "group:allNonMajor"
  ],
  "kubernetes": {
    "fileMatch": ["terraform/kubernetes/.*\\.ya?ml$"]
  },
  "helm-values": {
    "fileMatch": ["terraform/helm/.*-values\\.ya?ml$"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["node"],
      "matchManagers": ["dockerfile"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ]
}
