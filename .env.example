# ══════════════════════════════════════════════════════════════════════════════
# PARILINK ENTERPRISE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and populate all values.
# NEVER commit .env to version control.
# Production secrets MUST be injected via a secrets manager (Vault, AWS SSM, 
# GCP Secret Manager, etc.) — NOT from this file.

# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ────────────────────────────────────────────────────────────────
# Use PgBouncer in front of PostgreSQL for connection pooling in production
DATABASE_URL=postgresql://parilink:password@localhost:5432/parilink
SHADOW_DATABASE_URL=postgresql://parilink:password@localhost:5432/parilink_shadow

# ── Authentication ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_64_BYTE_HEX_SECRET_HERE

# ── Cookie Security ────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=GENERATE_32_BYTE_HEX_SECRET_HERE

# ── Envelope Encryption (KEK) ──────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# V1 = active key. V2 = rotation key (promoted on next deploy during rotation).
MASTER_ENCRYPTION_KEY_V1=GENERATE_32_BYTE_HEX_KEY_HERE
# MASTER_ENCRYPTION_KEY_V2=GENERATE_32_BYTE_HEX_KEY_HERE_FOR_ROTATION

# ── Field-level Encryption (legacy CryptoService — being phased out) ───────
ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_KEY_HERE

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (exact match, no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ── Redis (Caching, Rate Limiting, Session Store) ──────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage ────────────────────────────────────────────────────────
# S3-compatible: AWS S3, Cloudflare R2, MinIO
STORAGE_PROVIDER=local   # local | s3 | r2
STORAGE_BUCKET=parilink-documents
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Frontend Specific Variables ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_TELEMETRY_DISABLED=1

# ── Observability ──────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=parilink-api
# SENTRY_DSN=
