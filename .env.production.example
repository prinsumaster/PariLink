# PariLink Production Environment Variables
# Provide these values to your deployment platform (EKS, AWS Secrets Manager, Vercel).
# NEVER COMMIT REAL VALUES TO SOURCE CONTROL.

# ── REQUIRED (PUBLIC) ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
NEXT_PUBLIC_API_URL=https://api.parilink.app/api/v1

# ── REQUIRED (SECRETS) ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/parilink
JWT_SECRET=<Generate with: openssl rand -hex 64>
COOKIE_SECRET=<Generate with: openssl rand -hex 32>
MASTER_ENCRYPTION_KEY_V1=<Generate with: openssl rand -hex 32>
CORS_ALLOWED_ORIGINS=https://parilink.app,https://www.parilink.app
REDIS_URL=redis://<elasticache-endpoint>:6379

# ── OPTIONAL / CONFIGURABLE ────────────────────────────────────────────────────
STORAGE_PROVIDER=s3
STORAGE_BUCKET=parilink-production-documents
AWS_REGION=ap-south-1

# Only needed if not using IAM Roles for Service Accounts (IRSA)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
