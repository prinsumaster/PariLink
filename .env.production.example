# PariLink Production Environment Configuration Example
# Copy this file to .env.production and fill in all variables before deployment.

# ==========================================
# CORE APPLICATION SETTINGS
# ==========================================
NODE_ENV=production
PORT=3000
APP_URL=https://app.parilink.com
API_URL=https://api.parilink.com
NEXT_PUBLIC_API_URL=https://api.parilink.com
NEXT_PUBLIC_WS_URL=wss://api.parilink.com/telemetry
NEXT_PUBLIC_YJS_URL=wss://api.parilink.com/collaboration
NEXT_PUBLIC_DEMO_URL=mailto:sales@parilink.com?subject=PariLink Demo Request

# ==========================================
# DATABASE (POSTGRESQL & PGBOUNCER)
# ==========================================
# App Database (for regular queries, mapped via pgbouncer)
DATABASE_URL="postgresql://parilink:YOUR_SECURE_PASSWORD@pgbouncer:6432/parilink_db?schema=public&pgbouncer=true"

# System Database (for migrations and bypass-RLS operations)
SYSTEM_DATABASE_URL="postgresql://parilink_sys:YOUR_SECURE_SYS_PASSWORD@pgbouncer:6432/parilink_db?schema=public&pgbouncer=true"

# Raw Database URL for Prisma Migrations (bypass PgBouncer)
APP_DATABASE_URL="postgresql://postgres:SUPERUSER_PASSWORD@postgres:5432/parilink_db?schema=public"

# Password for the app database user
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
PARILINK_SYS_PASSWORD=YOUR_SECURE_SYS_PASSWORD

# Feature Flags
USE_PGBOUNCER=true

# ==========================================
# REDIS (CACHING, BULLMQ, WEBSOCKETS)
# ==========================================
REDIS_URL="redis://:YOUR_REDIS_PASSWORD@redis:6379"

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# NextAuth Secret for Web App (Must be secure, random string)
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET

# JWT Asymmetric Keys (for backend token issuance and verification)
# Must be base64 encoded RSA private/public keys
JWT_PRIVATE_KEY=YOUR_BASE64_PRIVATE_KEY
JWT_PUBLIC_KEY=YOUR_BASE64_PUBLIC_KEY
# Do not set to true in production!
ALLOW_EPHEMERAL_JWT_KEYS=false

# WebAuthn settings
WEBAUTHN_ORIGIN=https://app.parilink.com
WEBAUTHN_RPID=parilink.com
DEVICE_BINDING_ENFORCEMENT=STRICT

# CORS and Cookies
CORS_ALLOWED_ORIGINS=https://app.parilink.com
COOKIE_DOMAIN=.parilink.com
COOKIE_SECRET=YOUR_SECURE_COOKIE_SECRET

# ==========================================
# ENCRYPTION KEYS
# ==========================================
# Symmetric 256-bit encryption key (must be exactly 32 bytes)
ENCRYPTION_KEY=YOUR_32_BYTE_ENCRYPTION_KEY

# API Platform keys (for developers generating API keys)
API_SIGNING_SECRET=YOUR_API_SIGNING_SECRET

# Master Encryption keys for data-at-rest fields
MASTER_ENCRYPTION_KEY=YOUR_MASTER_ENCRYPTION_KEY
MASTER_ENCRYPTION_KEY_V1=YOUR_MASTER_ENCRYPTION_KEY_V1
MASTER_ENCRYPTION_KEY_V2=YOUR_MASTER_ENCRYPTION_KEY_V2

# ==========================================
# INTEGRATIONS & WEBHOOKS
# ==========================================
# Secret used for HMAC signing of outbound webhooks
WEBHOOK_SECRET=YOUR_SECURE_WEBHOOK_SECRET

# Salesforce
SF_CLIENT_ID=YOUR_SF_CLIENT_ID
SF_CLIENT_SECRET=YOUR_SF_CLIENT_SECRET
OAUTH_REDIRECT_URI=https://api.parilink.com/api/integrations/callback

# QuickBooks
QB_CLIENT_ID=YOUR_QB_CLIENT_ID
QB_CLIENT_SECRET=YOUR_QB_CLIENT_SECRET

# ==========================================
# AI & LLM CONFIGURATION
# ==========================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ==========================================
# INFRASTRUCTURE & MONITORING
# ==========================================
RUN_WORKERS=true
OTEL_EXPORTER_OTLP_ENDPOINT=YOUR_OTLP_ENDPOINT
BLOCKED_IPS=""
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
