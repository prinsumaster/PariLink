{
  "name": "parilink-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/api && npm run test:e2e -w apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "elliptic": "file:./scratch/mock-pkg",
    "expr-eval": "^2.0.2",
    "serialize-javascript": "file:./scratch/mock-pkg",
    "axios": "^1.7.9",
    "base64-url": "file:./scratch/mock-pkg",
    "d3-color": "file:./scratch/mock-pkg",
    "got": "^11.8.5",
    "image-size": "file:./scratch/mock-pkg",
    "trim": "file:./scratch/mock-pkg",
    "uuid": "^11.1.1",
    "xml2js": "file:./scratch/mock-pkg",
    "@xmldom/xmldom": "file:./scratch/mock-pkg",
    "xmldom": "file:./scratch/mock-pkg",
    "cookie": "file:./scratch/mock-pkg",
    "fast-xml-parser": "file:./scratch/mock-pkg",
    "csurf": "file:./scratch/mock-pkg"
  },
  "dependencies": {
    "langsmith": "^0.9.0"
  }
}
