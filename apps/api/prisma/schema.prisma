  sgstRate        Float
  igstRate        Float
  cessRate        Float     @default(0)
  isReverseCharge Boolean   @default(false)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

