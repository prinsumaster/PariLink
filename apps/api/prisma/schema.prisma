generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "multiSchema", "postgresqlExtensions", "metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                         String                       @id @default(uuid())
  name                       String
  taxId                      String?
  address                    String?
  city                       String?
  state                      String?
  country                    String?
  postalCode                 String?
  phone                      String?
  email                      String?
  website                    String?
  status                     String                       @default("ACTIVE")
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  deletedAt                  DateTime?
  subscriptionPlanId         String?
  stripeCustomerId           String?
  stripeSubscriptionId       String?
  accounts                   Account[]
  apiKeys                    ApiKey[]
  auditLogs                  AuditLog[]
  branches                   Branch[]
  subscriptionPlan           SubscriptionPlan?            @relation(fields: [subscriptionPlanId], references: [id])
  creditNotes                CreditNote[]
  customers                  Customer[]
  documents                  Document[]
  drivers                    Driver[]
  expenses                   Expense[]
  integrationConfigs         IntegrationConfig[]
  invoices                   Invoice[]
  journalEntries             JournalEntry[]
  journalLines               JournalLine[]
  leaveRequests              LeaveRequest[]
  loads                      Load[]
  locationHistory            LocationHistory[]
  inboxThreads               InboxThread[]
  notificationPreferences    NotificationPreference[]
  payments                   Payment[]
  rateCards                  RateCard[]
  roles                      Role[]
  settlements                Settlement[]
  supportTickets             SupportTicket[]
  tenantConfiguration        TenantConfiguration?
  trips                      Trip[]
  users                      User[]
  vehicles                   Vehicle[]
  apiCredentials             ApiCredential[]
  vendors                    Vendor[]
  vendorBills                VendorBill[]
  webhookEndpoints           WebhookEndpoint[]
  identityProviders          IdentityProvider[]
  workflowRules              WorkflowRule[]
  Geofence                   Geofence[]
  GeofenceEvent              GeofenceEvent[]
  AlertRule                  AlertRule[]
  Alert                      Alert[]
  VehicleTelemetry           VehicleTelemetry[]
  DomainEvent                DomainEvent[]
  TwinSnapshot               TwinSnapshot[]
  DispatchPlan               DispatchPlan[]
  DispatchCandidate          DispatchCandidate[]
  ConstraintViolation        ConstraintViolation[]
  CustomerPromise            CustomerPromise[]
  OptimizationScenario       OptimizationScenario[]
  OptimizationRecommendation OptimizationRecommendation[]
  OptimizationWeightConfig   OptimizationWeightConfig[]
  OptimizationFeedback       OptimizationFeedback[]
  Quotation                  Quotation[]
  Contract                   Contract[]
  Tender                     Tender[]
  Warehouse                  Warehouse[]
  InventoryItem              InventoryItem[]
  InboundReceipt             InboundReceipt[]
  OutboundWave               OutboundWave[]
  YardGateLog                YardGateLog[]
  MaterialEquipment          MaterialEquipment[]
  workflowDefinitions        WorkflowDefinition[]
  workflowExecutions         WorkflowExecution[]
  approvalRequests           ApprovalRequest[]
  integrationConnections     IntegrationConnection[]
  webhookDeliveries          WebhookDelivery[]
  dataMappingTemplates       DataMappingTemplate[]
  syncJobs                   SyncJob[]
  aiRecommendations          AiRecommendation[]
  aiPredictions              AiPrediction[]
  aiAnomalies                AiAnomaly[]
  aiAgents                   AiAgent[]
  aiInteractionLogs          AiInteractionLog[]
  aiMetricsLogs              AiMetricsLog[]
  featureFlags               FeatureFlag[]
  tenantConfigs              TenantConfig[]
  platformMetrics            PlatformMetric[]
  VehicleLocation            VehicleLocation[]
  GpsVehicleMapping          GpsVehicleMapping[]
  AppInstallation            AppInstallation[]
  documentFolders            DocumentFolder[]
  comments                   Comment[]
  fileExports                FileExport[]
  webResources               WebResource[]
  chatChannels               ChatChannel[]
  starredItems               StarredItem[]
  aiChatSessions             AiChatSession[]
  announcements              Announcement[]
  backgroundJobs             BackgroundJob[]
  workspaceSnapshots         WorkspaceSnapshot[]
  operationalAnomalies       OperationalAnomaly[]
  eventTimelines             EventTimeline[]
  ruleExecutionHistories     RuleExecutionHistory[]
  oauthClients               OAuthClient[]
  personalAccessTokens       PersonalAccessToken[]
  developerApps              DeveloperApp[]
  operationalPlans           OperationalPlan[]
  businessHealthSnapshots    BusinessHealthSnapshot[]
  departments                Department[]
  teams                      Team[]
  costCenters                CostCenter[]
  documentSignatures         DocumentSignature[]
  complianceRequirements     ComplianceRequirement[]

  crmLeads          CrmLead[]
  crmActivities     CrmActivity[]
  salesTargets      SalesTarget[]
  gstTaxRules       GstTaxRule[]
  taxLedgers        TaxLedger[]
  tollAccounts      TollAccount[]
  tollTransactions  TollTransaction[]
  bankAccounts      BankAccount[]
  bankStatements    BankStatement[]
  bankTransactions  BankTransaction[]
  vehiclePermits    VehiclePermit[]
  payrollStructures PayrollStructure[]
  payrollRuns       PayrollRun[]
  payslips          Payslip[]
  driverAttendances DriverAttendance[]
  DriverScore       DriverScore[]
  FleetKpiSnapshot  FleetKpiSnapshot[]
  Claim             Claim[]
  WorkOrder         WorkOrder[]
  EmergencyAlert    EmergencyAlert[]

  @@index([status])
  @@index([subscriptionPlanId])
}

model Trip {
  id                String            @id @default(uuid())
  companyId         String
  tripNumber        String            @unique
  driverId          String?
  vehicleId         String?
  trailerId         String?
  status            String            @default("PLANNED")
  startDate         DateTime?
  endDate           DateTime?
  eta               DateTime?
  startOdometer     Float?
  endOdometer       Float?
  estimatedDistance Float?
  actualDistance    Float?
  route             Json?
  checklists        Json?
  timeline          Json?
  fuelExpenses      Float?
  otherExpenses     Float?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  expenses          Expense[]
  loads             Load[]
  locationHistory   LocationHistory[]
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver            Driver?           @relation(fields: [driverId], references: [id])
  trailer           Vehicle?          @relation("TripTrailer", fields: [trailerId], references: [id])
  vehicle           Vehicle?          @relation("TripVehicle", fields: [vehicleId], references: [id])

  tollTransactions TollTransaction[]
  EmergencyAlert   EmergencyAlert[]

  @@index([companyId, status])
  @@index([driverId])
  @@index([vehicleId])
  @@index([companyId, deletedAt])
}

model LocationHistory {
  id        String   @id @default(uuid())
  companyId String
  tripId    String
  driverId  String
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  timestamp DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([companyId, driverId, timestamp])
  @@index([companyId, tripId, timestamp])
}

model Load {
  id                 String           @id @default(uuid())
  companyId          String
  customerId         String
  tripId             String?
  referenceNumber    String
  consignor          String?
  consignee          String?
  originAddress      String
  originCity         String
  originState        String
  destinationAddress String
  destinationCity    String
  destinationState   String
  pickupDate         DateTime
  deliveryDate       DateTime
  weight             Float?
  volume             Float?
  equipmentType      String           @default("DRY_VAN")
  vehicleRequirement String?
  trailerRequirement String?
  status             String           @default("PENDING")
  rate               Float
  cost               Float?
  boardPosition      Float? // For Kanban ordering
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  documents          Document[]
  invoices           Invoice[]
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer         @relation(fields: [customerId], references: [id])
  trip               Trip?            @relation(fields: [tripId], references: [id])
  DispatchPlan       DispatchPlan[]
  CustomerPromise    CustomerPromise?
  InboundReceipt     InboundReceipt[]
  OutboundWave       OutboundWave[]
  OutboundOrder      OutboundOrder?
  DockAppointment    DockAppointment?
  Claim              Claim[]

  @@index([companyId, status])
  @@index([customerId])
  @@index([companyId, tripId])
  @@index([companyId, deletedAt])
}

model Document {
  id              String              @id @default(uuid())
  companyId       String
  loadId          String?
  entityId        String? // Polymorphic entity ID (fallback)
  entityType      String? // Polymorphic entity Type (fallback)
  type            String
  fileUrl         String
  fileName        String
  mimeType        String?
  sizeBytes       Int?
  uploadedById    String?
  version         Int                 @default(1)
  category        String?
  tags            Json                @default("[]")
  folderId        String?
  isLocked        Boolean             @default(false)
  lockedById      String?
  expiresAt       DateTime?
  metadata        Json?               @default("{}")
  status          String              @default("ACTIVE")
  retentionPolicy String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  load            Load?               @relation(fields: [loadId], references: [id], onDelete: Cascade)
  uploadedBy      User?               @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  lockedBy        User?               @relation("DocumentLockedBy", fields: [lockedById], references: [id])
  folder          DocumentFolder?     @relation(fields: [folderId], references: [id])
  versions        DocumentVersion[]
  signatures      DocumentSignature[]

  @@index([companyId, loadId])
  @@index([companyId, uploadedById])
  @@index([companyId, folderId])
  @@index([entityType, entityId])
  @@index([companyId, deletedAt])
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  version       Int
  fileUrl       String
  fileName      String
  sizeBytes     Int?
  mimeType      String?
  uploadedById  String?
  changeSummary String?
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, version])
}

model DocumentSignature {
  id           String    @id @default(uuid())
  documentId   String
  companyId    String
  signerId     String?
  signerEmail  String
  signerName   String
  status       String    @default("PENDING") // PENDING, SIGNED, REJECTED
  signatureUrl String?
  ipAddress    String?
  userAgent    String?
  documentHash String?
  signedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, documentId])
  @@index([signerEmail, status])
}

model ComplianceRequirement {
  id           String   @id @default(uuid())
  companyId    String
  entityType   String // DRIVER, VEHICLE, VENDOR, COMPANY
  docType      String // CDL, MEDICAL_CARD, INSURANCE, REGISTRATION, W9, OPERATING_AUTHORITY, etc.
  name         String
  description  String?
  isMandatory  Boolean  @default(true)
  validityDays Int? // Default validity in days if applicable
  warningDays  Int      @default(30) // Alert when within X days of expiration
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType])
}

model Invoice {
  id            String            @id @default(uuid())
  companyId     String
  customerId    String
  loadId        String?
  invoiceNumber String
  amount        Float
  status        String            @default("DRAFT")
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  creditNotes   CreditNote[]
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer          @relation(fields: [customerId], references: [id])
  load          Load?             @relation(fields: [loadId], references: [id])
  lineItems     InvoiceLineItem[]
  payments      Payment[]

  @@index([companyId, status])
  @@index([customerId])
  @@index([loadId])
  @@index([companyId, deletedAt])
}

model Payment {
  id              String   @id @default(uuid())
  companyId       String
  invoiceId       String
  amount          Float
  method          String
  referenceNumber String?
  paymentDate     DateTime
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, invoiceId])
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  amount      Float
  type        String   @default("LINE_HAUL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Customer {
  id             String      @id @default(uuid())
  companyId      String
  name           String
  code           String?
  email          String?
  phone          String?
  billingAddress String?
  taxId          String?
  paymentTerms   String      @default("NET_30")
  creditLimit    Float?      @default(0)
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  loads          Load[]
  rateCards      RateCard[]
  Quotation      Quotation[]
  Contract       Contract[]
  Claim          Claim[]
  users          User[]

  masterRecordId String?
  masterRecord   MasterRecord? @relation(fields: [masterRecordId], references: [id])

  @@index([companyId, status])
  @@index([masterRecordId])
  @@index([companyId, deletedAt])
}

model Vendor {
  id             String       @id @default(uuid())
  companyId      String
  name           String
  code           String?
  email          String?
  phone          String?
  billingAddress String?
  taxId          String?
  type           String       @default("CARRIER")
  paymentTerms   String       @default("NET_30")
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorBills    VendorBill[]
  Contract       Contract[]
  TenderBid      TenderBid[]
  users          User[]

  masterRecordId String?
  masterRecord   MasterRecord? @relation(fields: [masterRecordId], references: [id])

  @@index([companyId, status])
  @@index([masterRecordId])
  @@index([companyId, deletedAt])
}

model Driver {
  id              String            @id @default(uuid())
  companyId       String
  userId          String?           @unique
  firstName       String
  lastName        String
  email           String?
  phone           String?
  licenseNumber   String?
  licenseState    String?
  licenseExpiry   DateTime?
  status          String            @default("AVAILABLE")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id])
  expenses        Expense[]
  leaveRequests   LeaveRequest[]
  locationHistory LocationHistory[]
  settlements     Settlement[]
  trips           Trip[]
  yardGateLogs    YardGateLog[]
  Alert           Alert[]

  masterRecordId String?
  masterRecord   MasterRecord? @relation(fields: [masterRecordId], references: [id])

  payrollStructures PayrollStructure[]
  payslips          Payslip[]
  attendances       DriverAttendance[]
  driverScore       DriverScore?
  EmergencyAlert    EmergencyAlert[]

  @@index([companyId, status])
  @@index([masterRecordId])
  @@index([userId])
  @@index([companyId, deletedAt])
}

model Vehicle {
  id                String             @id @default(uuid())
  companyId         String
  make              String?
  model             String?
  year              Int?
  licensePlate      String?
  vin               String?
  type              String             @default("TRUCK")
  status            String             @default("IN_SERVICE")
  capacityWeight    Float?
  capacityVolume    Float?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  tripsTrailer      Trip[]             @relation("TripTrailer")
  tripsVehicle      Trip[]             @relation("TripVehicle")
  yardGateVehicles  YardGateLog[]      @relation("GateLogVehicle")
  yardGateTrailers  YardGateLog[]      @relation("GateLogTrailer")
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  GeofenceEvent     GeofenceEvent[]
  Alert             Alert[]
  VehicleTelemetry  VehicleTelemetry[]
  VehicleLocation   VehicleLocation[]
  GpsVehicleMapping GpsVehicleMapping?

  masterRecordId String?
  masterRecord   MasterRecord? @relation(fields: [masterRecordId], references: [id])

  tollTransactions TollTransaction[]
  permits          VehiclePermit[]
  WorkOrder        WorkOrder[]

  @@index([companyId, status])
  @@index([masterRecordId])
  @@index([companyId, deletedAt])
}

model Role {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  description String?
  permissions Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]

  payrollStructures PayrollStructure[]

  @@index([companyId])
  @@index([companyId, deletedAt])
}

model Branch {
  id         String    @id @default(uuid())
  companyId  String
  name       String
  code       String?
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  phone      String?
  email      String?
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users      User[]

  @@index([companyId])
  @@index([companyId, deletedAt])
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String
  firstName              String
  lastName               String
  phone                  String?
  avatar                 String?
  status                 String                  @default("ACTIVE")
  roleId                 String?
  companyId              String
  departmentId           String?
  teamId                 String?
  costCenterId           String?
  branchId               String?
  region                 String?
  zone                   String?
  hub                    String?
  cluster                String?
  mfaEnabled             Boolean                 @default(false)
  totpSecret             String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  auditLogs              AuditLog[]
  uploadedDocuments      Document[]              @relation("DocumentUploadedBy")
  lockedDocuments        Document[]              @relation("DocumentLockedBy")
  driver                 Driver?
  notificationPreference NotificationPreference?
  refreshTokens          RefreshToken[]
  supportTickets         SupportTicket[]
  company                Company                 @relation(fields: [companyId], references: [id])
  role                   Role?                   @relation(fields: [roleId], references: [id])
  userWorkspaceState     UserWorkspaceState?
  comments               Comment[]
  fileExports            FileExport[]
  chatChannelMemberships ChatChannelMember[]
  sentMessages           ChatMessage[]           @relation("ChatMessageSender")
  messageReactions       MessageReaction[]       @relation("MessageReactionUser")
  aiChatSessions         AiChatSession[]         @relation("AiChatSessionUser")
  starredItems           StarredItem[]           @relation("StarredItemUser")
  inboxMessages          InboxMessage[]          @relation("InboxMessageSender")
  inboxThreads           InboxThread[]           @relation("InboxThreadUser")
  notifications          Notification[]          @relation("NotificationUser")
  preferences            Json                    @default("{}")
  backgroundJobs         BackgroundJob[]         @relation("BackgroundJobUser")
  workspaceSnapshots     WorkspaceSnapshot[]     @relation("WorkspaceSnapshotUser")
  apiKeys                ApiKey[]
  personalAccessTokens   PersonalAccessToken[]
  webAuthnCredentials    WebAuthnCredential[]
  backupCodes            BackupCode[]
  trustedDevices         TrustedDevice[]
  userIdentities         UserIdentity[]
  department             Department?             @relation(fields: [departmentId], references: [id])
  team                   Team?                   @relation(fields: [teamId], references: [id])
  costCenter             CostCenter?             @relation(fields: [costCenterId], references: [id])
  branch                 Branch?                 @relation(fields: [branchId], references: [id])
  customer               Customer?               @relation(fields: [customerId], references: [id])
  customerId             String?
  vendor                 Vendor?                 @relation(fields: [vendorId], references: [id])
  vendorId               String?

  assignedLeads       CrmLead[]     @relation("LeadAssignee")
  performedActivities CrmActivity[] @relation("ActivityPerformer")
  salesTargets        SalesTarget[] @relation("UserTargets")
  payslips            Payslip[]

  @@index([companyId, status])
  @@index([costCenterId])
  @@index([teamId])
  @@index([departmentId])
  @@index([roleId])
  @@index([companyId, deletedAt])
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TrustedDevice {
  id               String   @id @default(uuid())
  userId           String
  deviceIdentifier String
  deviceInfo       String?
  ipAddress        String?
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceIdentifier])
}

model WebAuthnCredential {
  id                   String   @id @default(uuid())
  userId               String
  credentialID         Bytes    @unique
  credentialPublicKey  Bytes
  counter              Int      @default(0)
  credentialDeviceType String
  credentialBackedUp   Boolean  @default(false)
  transports           Json     @default("[]")
  createdAt            DateTime @default(now())
  lastUsedAt           DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  token             String    @unique
  userId            String
  deviceInfo        String?
  ipAddress         String?
  lastActiveAt      DateTime  @default(now())
  expiresAt         DateTime
  isRevoked         Boolean   @default(false)
  familyId          String    @default(uuid())
  replacedByToken   String?
  deviceFingerprint String?
  history           Json      @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id            String   @id @default(uuid())
  companyId     String
  userId        String?
  entity        String // Keep existing
  entityType    String? // e.g., 'Load', 'Invoice', 'FeatureFlag'
  entityId      String
  action        String // CREATE, UPDATE, DELETE
  details       Json? // Keep existing
  beforeValue   Json?
  afterValue    Json?
  reason        String?
  correlationId String?
  source        String? // e.g., 'API', 'WORKFLOW', 'AI_AGENT', 'INTEGRATION'
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])

  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
  @@index([userId])
}

model RateCard {
  id              String    @id @default(uuid())
  companyId       String
  customerId      String
  type            String
  rate            Float
  fuelSurcharge   Float?    @default(0)
  tollSurcharge   Float?    @default(0)
  waitingCharge   Float?    @default(0)
  currency        String    @default("USD")
  originCity      String?
  destinationCity String?
  validFrom       DateTime?
  validTo         DateTime?
  minimumCharge   Float?    @default(0)
  equipmentType   String?
  version         Int       @default(1)
  status          String    @default("APPROVED") // DRAFT, APPROVED, EXPIRED
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([companyId])
}

model CreditNote {
  id        String   @id @default(uuid())
  companyId String
  invoiceId String
  amount    Float
  reason    String
  status    String   @default("ISSUED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([companyId])
}

model Settlement {
  id          String   @id @default(uuid())
  companyId   String
  driverId    String
  amount      Float
  type        String
  status      String   @default("DRAFT")
  periodStart DateTime
  periodEnd   DateTime
  advances    Float    @default(0)
  deductions  Float    @default(0)
  netPayable  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([companyId])
}

model VendorBill {
  id         String    @id @default(uuid())
  companyId  String
  vendorId   String
  billNumber String
  amount     Float
  dueDate    DateTime?
  status     String    @default("DRAFT")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([companyId])
}

model Expense {
  id        String   @id @default(uuid())
  companyId String
  tripId    String?
  driverId  String?
  type      String
  amount    Float
  date      DateTime
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver    Driver?  @relation(fields: [driverId], references: [id])
  trip      Trip?    @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@index([driverId])
  @@index([companyId])
}

model Account {
  id           String        @id @default(uuid())
  companyId    String
  name         String
  code         String
  type         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([companyId, code])
  @@index([companyId])
}

model JournalEntry {
  id            String        @id @default(uuid())
  companyId     String
  referenceType String
  referenceId   String?
  date          DateTime      @default(now())
  description   String
  status        String        @default("DRAFT")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines         JournalLine[]

  @@index([companyId, date])
  @@index([companyId, referenceType, referenceId])
}

model JournalLine {
  id          String       @id @default(uuid())
  companyId   String
  entryId     String
  accountId   String
  debit       Float        @default(0)
  credit      Float        @default(0)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([companyId, accountId])
  @@index([companyId, entryId])
}

model SubscriptionPlan {
  id                 String    @id @default(uuid())
  name               String
  planCode           String    @default("STARTER") // STARTER, GROWTH, PROFESSIONAL, BUSINESS, ENTERPRISE, ENTERPRISE_PLUS, CUSTOM
  description        String?
  price              Float
  currency           String    @default("USD")
  interval           String    @default("month")
  stripePriceId      String?
  features           Json      @default("{}")
  defaultMaxVehicles Int       @default(20)
  defaultMaxDrivers  Int       @default(50)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  companies          Company[]
}

model TenantConfiguration {
  id                   String   @id @default(uuid())
  companyId            String   @unique
  settings             Json     @default("{}")
  theme                Json     @default("{}")
  policies             Json     @default("{}")
  onboardingCompleted  Boolean  @default(false)
  logoUrl              String?
  timezone             String   @default("UTC")
  currency             String   @default("USD")
  language             String   @default("en")
  fiscalYearStartMonth Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SupportTicket {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  subject     String
  description String
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

model LeaveRequest {
  id        String   @id @default(uuid())
  companyId String
  driverId  String
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([companyId])
}

model WorkflowRule {
  id                 String                 @id @default(uuid())
  companyId          String
  name               String
  entityType         String
  trigger            String
  conditions         Json                   @default("[]")
  actions            Json                   @default("[]")
  version            Int                    @default(1)
  priority           Int                    @default(0)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  executionHistories RuleExecutionHistory[]

  @@index([companyId])
}

model RuleExecutionHistory {
  id                String   @id @default(uuid())
  companyId         String
  ruleId            String
  entityId          String
  entityType        String
  result            String // PASS, FAIL, WARNING, INFORMATION
  explanation       String?
  matchedConditions Json?    @default("[]")
  executedActions   Json?    @default("[]")
  executionTimeMs   Int?     @default(0)
  createdAt         DateTime @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule    WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([companyId, ruleId])
  @@index([companyId, entityType, entityId])
}

model ApiKey {
  id          String    @id @default(uuid())
  companyId   String
  userId      String?
  name        String
  keyHash     String
  scopes      Json      @default("[]")
  environment String    @default("production")
  expiresAt   DateTime?
  lastUsed    DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

model OAuthClient {
  id           String       @id @default(uuid())
  companyId    String
  clientId     String       @unique
  clientSecret String
  name         String
  description  String?
  scopes       Json         @default("[]")
  redirectUris Json         @default("[]")
  grantTypes   Json         @default("[]")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokens       OAuthToken[]

  @@index([companyId])
}

model OAuthToken {
  id        String      @id @default(uuid())
  clientId  String
  tokenHash String      @unique
  type      String      @default("Bearer")
  scopes    Json        @default("[]")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model PersonalAccessToken {
  id         String    @id @default(uuid())
  companyId  String
  userId     String
  name       String
  tokenHash  String    @unique
  scopes     Json      @default("[]")
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

model WebhookEndpoint {
  id         String   @id @default(uuid())
  companyId  String
  url        String
  secret     String
  events     Json     @default("[]")
  isActive   Boolean  @default(true)
  retryCount Int      @default(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model IntegrationConfig {
  id          String   @id @default(uuid())
  companyId   String
  provider    String
  credentials Json
  settings    Json     @default("{}")
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// --- REAL-TIME FLEET INTELLIGENCE PLATFORM ---

model Geofence {
  id           String          @id @default(uuid())
  companyId    String
  name         String
  description  String?
  type         String          @default("CUSTOMER") // CUSTOMER, WAREHOUSE, DEPOT, TOLL, PORT, BORDER
  latitude     Float
  longitude    Float
  radiusMeters Float           @default(100) // Circular geofence
  polygon      Json? // Optional for complex polygons: [{lat, lng}]
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events       GeofenceEvent[]

  @@index([companyId])
}

model GeofenceEvent {
  id         String   @id @default(uuid())
  companyId  String
  geofenceId String
  vehicleId  String
  eventType  String // ENTER, EXIT
  timestamp  DateTime @default(now())
  metadata   Json? // E.g. Dwell time on EXIT
  geofence   Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, vehicleId, timestamp])
  @@index([geofenceId, eventType])
}

model AlertRule {
  id        String   @id @default(uuid())
  companyId String
  name      String
  type      String // SPEEDING, IDLING, DEVIATION, OFF_HOURS, BATTERY, MAINTENANCE
  condition String // EXCEEDS, LESS_THAN, MATCHES
  threshold Float
  severity  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  alerts    Alert[]

  @@index([companyId])
}

model Alert {
  id         String    @id @default(uuid())
  companyId  String
  ruleId     String
  vehicleId  String?
  driverId   String?
  severity   String
  message    String
  status     String    @default("NEW") // NEW, ACKNOWLEDGED, RESOLVED
  timestamp  DateTime  @default(now())
  resolvedAt DateTime?
  metadata   Json? // Actual value vs threshold
  rule       AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver     Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, timestamp])
  @@index([vehicleId])
  @@index([driverId])
  @@index([ruleId])
}

model VehicleTelemetry {
  id           String   @id @default(uuid())
  companyId    String
  vehicleId    String
  odometer     Float?
  engineHours  Float?
  fuelLevel    Float?
  batteryVolts Float?
  coolantTemp  Float?
  engineLoad   Float?
  rpm          Float?
  dtcCodes     Json? // Diagnostic Trouble Codes (e.g., ["P0171", "P0300"])
  ignition     Boolean?
  timestamp    DateTime @default(now())
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, vehicleId, timestamp])
}

// --- DIGITAL TWIN & EVENT SOURCING PLATFORM ---

model DomainEvent {
  id            String   @id @default(uuid())
  companyId     String
  streamId      String // ID of the Twin (e.g. Vehicle ID)
  streamType    String // VEHICLE, DRIVER, TRIP
  eventType     String // e.g. GpsUpdated, FuelAdded
  version       Int // Optimistic concurrency
  payload       Json
  metadata      Json?
  correlationId String?
  userId        String? // SYSTEM or actual user id
  timestamp     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([streamId, version])
  @@index([companyId, streamId, timestamp])
  @@index([eventType, timestamp])
}

model TwinSnapshot {
  id        String   @id @default(uuid())
  companyId String
  twinId    String
  twinType  String
  version   Int
  state     Json
  timestamp DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([twinId, twinType])
  @@index([companyId, twinType])
}

// ─────────────────────────────────────────────────────────────
// INTELLIGENT DISPATCH & PLANNING ENGINE
// ─────────────────────────────────────────────────────────────

model DispatchPlan {
  id                  String                @id @default(uuid())
  companyId           String
  loadId              String
  status              String                @default("DRAFT")
  // DRAFT → PLANNED → VALIDATED → ASSIGNED → ACCEPTED → REJECTED → IN_TRANSIT → PAUSED → COMPLETED → CANCELLED
  assignedVehicleId   String?
  assignedDriverId    String?
  assignedTrailerId   String?
  dispatchedAt        DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  completedAt         DateTime?
  dispatcherId        String? // user who dispatched
  overrideReason      String? // manual override reason
  scoringWeights      Json                  @default("{}")
  selectedCandidateId String?
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  load                Load                  @relation(fields: [loadId], references: [id])
  candidates          DispatchCandidate[]
  violations          ConstraintViolation[]

  @@index([companyId, status])
  @@index([loadId])
}

model DispatchCandidate {
  id             String       @id @default(uuid())
  planId         String
  companyId      String
  vehicleId      String
  driverId       String
  trailerId      String?
  totalScore     Float        @default(0)
  scoreBreakdown Json         @default("{}") // { distanceScore, hoursScore, utilizationScore, … }
  isSelected     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  plan           DispatchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([companyId, vehicleId])
}

model ConstraintViolation {
  id         String       @id @default(uuid())
  planId     String
  companyId  String
  vehicleId  String?
  driverId   String?
  constraint String // e.g. WEIGHT_EXCEEDED, LICENSE_EXPIRED
  message    String
  isFatal    Boolean      @default(true)
  createdAt  DateTime     @default(now())
  plan       DispatchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([companyId])
}

model CustomerPromise {
  id                  String    @id @default(uuid())
  companyId           String
  loadId              String    @unique
  load                Load      @relation(fields: [loadId], references: [id], onDelete: Cascade)
  committedPickupAt   DateTime?
  committedDeliveryAt DateTime?
  estimatedArrivalAt  DateTime?
  delayRiskScore      Float     @default(0) // 0–1
  confidenceScore     Float     @default(1) // 0–1
  reasonCode          String?
  lastUpdatedAt       DateTime  @default(now())
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([loadId])
}

// ─────────────────────────────────────────────────────────────
// OPTIMIZATION & ORCHESTRATION ENGINE
// ─────────────────────────────────────────────────────────────

model OptimizationScenario {
  id                String                       @id @default(uuid())
  companyId         String
  objective         String // COST_MINIMIZATION, TIME_MINIMIZATION, UTILIZATION_MAXIMIZATION
  status            String                       @default("GENERATED") // GENERATED, ACCEPTED, REJECTED, EXPIRED
  totalCost         Float                        @default(0)
  totalRevenue      Float                        @default(0)
  margin            Float                        @default(0)
  confidenceScore   Float                        @default(1.0)
  explanation       String?
  simulatedTrigger  String? // E.g., 'TRUCK_UNAVAILABLE', 'TRAFFIC_CONGESTION'
  simulationContext Json? // The parameters for the simulation
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  company           Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recommendations   OptimizationRecommendation[]

  @@index([companyId, status])
}

model OperationalPlan {
  id        String                @id @default(uuid())
  companyId String
  date      DateTime              @db.Date
  status    String                @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  metrics   Json                  @default("{}") // totalSavings, fuelSaved, onTimePercentage, totalRevenue
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     OperationalPlanItem[]

  @@index([companyId, date])
  @@index([companyId, status])
}

model OperationalPlanItem {
  id                 String          @id @default(uuid())
  planId             String
  loadId             String?
  vehicleId          String?
  driverId           String?
  status             String          @default("AUTO_PLANNED") // AUTO_PLANNED, NEEDS_APPROVAL, REQUIRES_HUMAN
  confidenceScore    Float           @default(1.0)
  expectedCost       Float           @default(0)
  expectedRevenue    Float           @default(0)
  aiDecisionProposal Json? // Store the structured AiDecisionProposal schema here if it's an exception
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  plan               OperationalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, status])
}

model OptimizationRecommendation {
  id                      String               @id @default(uuid())
  scenarioId              String
  companyId               String
  loadId                  String
  vehicleId               String?
  driverId                String?
  trailerId               String?
  expectedCost            Float                @default(0)
  expectedRevenue         Float                @default(0)
  confidenceScore         Float                @default(1.0)
  reasonCodes             Json                 @default("[]")
  optimizationVersion     String               @default("1.0")
  estimatedSavings        Float                @default(0)
  estimatedFuelSaved      Float                @default(0)
  estimatedTimeSaved      Float                @default(0) // In hours
  carbonReductionEstimate Float                @default(0) // In kg CO2
  dispatcherExplanation   String?              @db.Text
  createdAt               DateTime             @default(now())
  scenario                OptimizationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@index([companyId])
}

model OptimizationWeightConfig {
  id                String   @id @default(uuid())
  companyId         String
  fuelCostWeight    Float    @default(0.30)
  slaWeight         Float    @default(0.25)
  fleetUtilWeight   Float    @default(0.20)
  driverPrefWeight  Float    @default(0.10)
  maintenanceWeight Float    @default(0.10)
  carbonWeight      Float    @default(0.05)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model OptimizationFeedback {
  id               String   @id @default(uuid())
  companyId        String
  recommendationId String
  userId           String
  action           String // ACCEPTED, REJECTED, MODIFIED, IGNORED
  reason           String?  @db.Text
  createdAt        DateTime @default(now())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([recommendationId])
}

// ─────────────────────────────────────────────────────────────
// COMMERCIAL INTELLIGENCE PLATFORM
// ─────────────────────────────────────────────────────────────

model Quotation {
  id          String    @id @default(uuid())
  companyId   String
  customerId  String
  status      String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, EXPIRED, CONVERTED
  totalAmount Float     @default(0)
  taxAmount   Float     @default(0)
  currency    String    @default("USD")
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([customerId])
}

model Contract {
  id                   String    @id @default(uuid())
  companyId            String
  customerId           String?
  vendorId             String?
  type                 String // MSA, CARRIER_AGREEMENT, SERVICE_LEVEL
  status               String    @default("DRAFT") // DRAFT, ACTIVE, EXPIRED, TERMINATED
  startDate            DateTime?
  endDate              DateTime?
  paymentTerms         String?
  slaPickupOnTimePct   Float?
  slaDeliveryOnTimePct Float?
  penaltyPerLateDay    Float?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor               Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([vendorId])
  @@index([customerId])
}

model Tender {
  id                 String        @id @default(uuid())
  companyId          String
  title              String
  status             String        @default("OPEN") // OPEN, CLOSED, AWARDED, CANCELLED
  submissionDeadline DateTime?
  origin             String?
  destination        String?
  expectedVolume     Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bids               TenderBid[]
  YardGateLog        YardGateLog[]

  @@index([companyId, status])
}

model TenderBid {
  id        String   @id @default(uuid())
  tenderId  String
  vendorId  String
  bidAmount Float
  currency  String   @default("USD")
  status    String   @default("SUBMITTED") // SUBMITTED, ACCEPTED, REJECTED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([vendorId])
}

// ─────────────────────────────────────────────────────────────
// WAREHOUSE & YARD MANAGEMENT PLATFORM
// ─────────────────────────────────────────────────────────────

model Warehouse {
  id              String          @id @default(uuid())
  companyId       String
  name            String
  code            String
  address         String
  city            String
  state           String
  capacityPallets Int?
  operatingHours  String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zones           WarehouseZone[]
  docks           YardDock[]
  inventory       InventoryItem[]

  masterRecordId String?
  masterRecord   MasterRecord? @relation(fields: [masterRecordId], references: [id])

  @@index([companyId])
  @@index([code])
  @@index([masterRecordId])
}

model WarehouseZone {
  id          String         @id @default(uuid())
  warehouseId String
  name        String
  code        String
  type        String // AMBIENT, CHILLED, FROZEN, HAZMAT, STAGING
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bins        WarehouseBin[]

  @@index([warehouseId])
}

model WarehouseBin {
  id        String          @id @default(uuid())
  zoneId    String
  code      String // e.g., A-01-01
  aisle     String?
  row       String?
  level     String?
  status    String          @default("AVAILABLE") // AVAILABLE, FULL, BLOCKED
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  zone      WarehouseZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  inventory InventoryItem[]

  @@index([zoneId, status])
  @@index([code])
}

model InventoryItem {
  id            String        @id @default(uuid())
  companyId     String
  warehouseId   String
  binId         String?
  sku           String
  description   String?
  lotNumber     String?
  batchNumber   String?
  serialNumber  String?
  quantity      Float         @default(0)
  unitOfMeasure String        @default("PALLET") // PALLET, CARTON, PIECE
  status        String        @default("AVAILABLE") // AVAILABLE, RESERVED, DAMAGED, QUARANTINED, IN_TRANSIT
  expiryDate    DateTime?
  receivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  bin           WarehouseBin? @relation(fields: [binId], references: [id])

  @@index([companyId, sku])
  @@index([warehouseId, status])
  @@index([binId])
}

model InboundReceipt {
  id           String               @id @default(uuid())
  companyId    String
  warehouseId  String
  loadId       String?              @unique
  asnNumber    String               @unique
  status       String               @default("EXPECTED") // EXPECTED, ARRIVED, RECEIVING, RECEIVED, PUT_AWAY
  expectedDate DateTime?
  actualDate   DateTime?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items        InboundReceiptItem[]
  load         Load?                @relation(fields: [loadId], references: [id])

  @@index([companyId, status])
  @@index([warehouseId])
  @@index([loadId])
}

model InboundReceiptItem {
  id          String         @id @default(uuid())
  receiptId   String
  sku         String
  expectedQty Float
  receivedQty Float          @default(0)
  damagedQty  Float          @default(0)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  receipt     InboundReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model OutboundWave {
  id            String          @id @default(uuid())
  companyId     String
  warehouseId   String
  code          String
  status        String          @default("PLANNED") // PLANNED, RELEASED, PICKING, STAGED, COMPLETED
  scheduledDate DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders        OutboundOrder[]
  Load          Load?           @relation(fields: [loadId], references: [id])
  loadId        String?

  @@index([companyId, status])
  @@index([warehouseId])
  @@index([loadId])
}

model OutboundOrder {
  id             String              @id @default(uuid())
  waveId         String?
  loadId         String?             @unique
  orderNumber    String
  status         String              @default("PENDING") // PENDING, PICKING, STAGED, LOADED, DISPATCHED
  stagedAtDockId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  wave           OutboundWave?       @relation(fields: [waveId], references: [id])
  stagedAtDock   YardDock?           @relation(fields: [stagedAtDockId], references: [id])
  load           Load?               @relation(fields: [loadId], references: [id])
  items          OutboundOrderItem[]

  @@index([waveId])
  @@index([loadId])
  @@index([stagedAtDockId])
}

model OutboundOrderItem {
  id           String        @id @default(uuid())
  orderId      String
  sku          String
  requestedQty Float
  pickedQty    Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        OutboundOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model YardDock {
  id             String            @id @default(uuid())
  warehouseId    String
  name           String // e.g. Dock 1
  type           String // INBOUND, OUTBOUND, MIXED
  status         String            @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  appointments   DockAppointment[]
  outboundOrders OutboundOrder[]

  @@index([warehouseId, status])
}

model DockAppointment {
  id             String    @id @default(uuid())
  dockId         String
  loadId         String?   @unique
  type           String // INBOUND, OUTBOUND
  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  status         String    @default("SCHEDULED") // SCHEDULED, ARRIVED, AT_DOCK, COMPLETED, CANCELLED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  dock           YardDock  @relation(fields: [dockId], references: [id], onDelete: Cascade)
  load           Load?     @relation(fields: [loadId], references: [id])

  @@index([dockId, scheduledStart])
  @@index([loadId])
}

model YardGateLog {
  id          String   @id @default(uuid())
  companyId   String
  warehouseId String
  vehicleId   String?
  trailerId   String?
  driverId    String?
  type        String // ENTRY, EXIT
  timestamp   DateTime @default(now())
  purpose     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle? @relation("GateLogVehicle", fields: [vehicleId], references: [id])
  trailer     Vehicle? @relation("GateLogTrailer", fields: [trailerId], references: [id])
  driver      Driver?  @relation(fields: [driverId], references: [id])
  Tender      Tender?  @relation(fields: [tenderId], references: [id])
  tenderId    String?

  @@index([companyId, warehouseId])
  @@index([tenderId])
  @@index([driverId])
}

model MaterialEquipment {
  id              String    @id @default(uuid())
  companyId       String
  warehouseId     String
  code            String
  type            String // FORKLIFT, PALLET_JACK
  status          String    @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE
  lastMaintenance DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, warehouseId, status])
}

// ─────────────────────────────────────────────────────────────
// WORKFLOW AUTOMATION PLATFORM
// ─────────────────────────────────────────────────────────────

model WorkflowDefinition {
  id           String              @id @default(uuid())
  companyId    String
  name         String
  description  String?
  version      Int                 @default(1)
  status       String              @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED, DISABLED
  triggerEvent String // e.g., 'TripStarted'
  graphPayload Json // The visual directed graph representation
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  executions   WorkflowExecution[]

  @@index([companyId, status])
  @@index([triggerEvent])
}

model WorkflowExecution {
  id             String                  @id @default(uuid())
  companyId      String
  workflowId     String
  status         String                  @default("RUNNING") // RUNNING, COMPLETED, FAILED, WAITING_APPROVAL
  triggerPayload Json // The event that triggered this execution
  context        Json                    @default("{}") // State passing between nodes
  retryCount     Int                     @default(0)
  startedAt      DateTime                @default(now())
  completedAt    DateTime?
  error          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflow       WorkflowDefinition      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps          WorkflowExecutionStep[]
  approvals      ApprovalRequest[]

  @@index([companyId, status])
  @@index([workflowId])
}

model WorkflowExecutionStep {
  id          String  @id @default(uuid())
  executionId String
  nodeId      String // ID from the graphPayload
  nodeType    String // TRIGGER, CONDITION, ACTION, DELAY, DECISION, APPROVAL
  status      String  @default("SUCCESS") // SUCCESS, FAILED, PENDING
  inputs      Json    @default("{}")
  outputs     Json    @default("{}")
  error       String?

  // Execution Engine Fields
  owner           String? // e.g., 'Dispatcher_AI', 'Finance_AI'
  retryCount      Int     @default(0)
  rollbackAction  String? // The compensating transaction event payload
  estimatedTimeMs Int? // Execution threshold

  executedAt DateTime          @default(now())
  execution  WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model ApprovalRequest {
  id          String            @id @default(uuid())
  companyId   String
  executionId String
  status      String            @default("PENDING") // PENDING, APPROVED, REJECTED, ESCALATED, TIMEOUT
  entityType  String // e.g., 'Quotation', 'Tender'
  entityId    String
  requestedBy String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  steps       ApprovalStep[]

  @@index([companyId, status])
  @@index([executionId])
}

model ApprovalStep {
  id             String          @id @default(uuid())
  requestId      String
  approverUserId String? // Null if assigned to a role
  approverRoleId String?
  status         String          @default("PENDING") // PENDING, APPROVED, REJECTED
  comments       String?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  request        ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ─────────────────────────────────────────────────────────────
// ENTERPRISE INTEGRATION PLATFORM (iPaaS)
// ─────────────────────────────────────────────────────────────

model IntegrationConnector {
  id              String                  @id @default(uuid())
  provider        String                  @unique // e.g., 'GOOGLE_MAPS', 'QUICKBOOKS'
  version         String                  @default("1.0.0")
  status          String                  @default("ACTIVE")
  categoryId      String?
  category        IntegrationCategory?    @relation(fields: [categoryId], references: [id])
  capabilities    Json                    @default("[]")
  supportedEvents Json                    @default("[]")
  authType        String // OAUTH2, API_KEY, BASIC
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  connections     IntegrationConnection[]

  @@index([categoryId])
}

model IntegrationConnection {
  id                String               @id @default(uuid())
  companyId         String
  connectorId       String
  status            String               @default("CONFIGURED") // INSTALLED, CONFIGURED, ENABLED, DISABLED, FAILED
  credentials       Json // Encrypted at rest
  settings          Json                 @default("{}")
  lastSync          DateTime?
  lastError         String?
  retryCount        Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connector         IntegrationConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  syncJobs          SyncJob[]
  scheduledSyncs    ScheduledSync[]
  syncErrors        SyncError[]
  GpsVehicleMapping GpsVehicleMapping[]

  @@index([companyId, status])
  @@index([connectorId])
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  companyId    String
  direction    String // INCOMING, OUTGOING
  endpointUrl  String
  eventTopic   String
  payload      Json
  status       String   @default("PENDING") // PENDING, SUCCESS, FAILED, RETRYING, DEAD_LETTER
  httpStatus   Int?
  responseBody String?
  retryCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([direction])
}

model DataMappingTemplate {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  sourceEntity String // e.g., 'QuickBooks.Invoice'
  targetEntity String // e.g., 'PariLink.Invoice'
  mappingRules Json // Field mappings, default values, transformations
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SyncJob {
  id               String                @id @default(uuid())
  companyId        String
  connectionId     String
  entityType       String // e.g., 'Invoice', 'Customer'
  direction        String // INBOUND, OUTBOUND, BIDIRECTIONAL
  status           String                @default("RUNNING") // RUNNING, COMPLETED, FAILED, PARTIAL
  recordsProcessed Int                   @default(0)
  recordsFailed    Int                   @default(0)
  error            String?
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([companyId, connectionId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// ENTERPRISE AI DECISION INTELLIGENCE PLATFORM
// ─────────────────────────────────────────────────────────────

model AiRecommendation {
  id             String    @id @default(uuid())
  companyId      String
  domainEntity   String // e.g., 'Dispatch', 'Commercial'
  entityId       String?
  recommendation String    @db.Text
  reasoning      String    @db.Text
  confidence     Float // 0.0 to 1.0
  evidence       Json      @default("[]")
  alternatives   Json      @default("[]")
  status         String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  actionTakenAt  DateTime?
  actionTakenBy  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([domainEntity, entityId])
}

model AiPrediction {
  id             String    @id @default(uuid())
  companyId      String
  targetEntity   String // e.g., 'TripETA', 'InventoryShortage'
  entityId       String?
  predictedValue Json
  confidence     Float
  factors        Json      @default("[]")
  actualValue    Json? // Filled in later by Observability
  accuracy       Float? // Calculated retroactively
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, targetEntity])
}

model AiAnomaly {
  id          String    @id @default(uuid())
  companyId   String
  category    String // e.g., 'RouteDeviation', 'BillingMismatch'
  severity    String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  description String    @db.Text
  evidence    Json
  status      String    @default("UNRESOLVED") // UNRESOLVED, INVESTIGATING, FALSE_POSITIVE, RESOLVED
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

model AiAgent {
  id              String             @id @default(uuid())
  companyId       String
  name            String // e.g., 'DispatchAgent'
  role            String             @db.Text
  systemPrompt    String             @db.Text
  tools           Json               @default("[]")
  isActive        Boolean            @default(true)
  version         String             @default("1.0.0")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interactionLogs AiInteractionLog[]

  @@index([companyId])
}

model AiInteractionLog {
  id        String   @id @default(uuid())
  companyId String
  agentId   String
  sessionId String
  userId    String?
  prompt    String   @db.Text
  response  String   @db.Text
  toolsUsed Json     @default("[]")
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent     AiAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([companyId, sessionId])
  @@index([agentId])
}

model AiMetricsLog {
  id               String   @id @default(uuid())
  companyId        String
  interactionId    String? // Links to AiRecommendation, Prediction, or InteractionLog
  modelProvider    String // e.g., 'MockAI', 'OpenAI', 'Gemini'
  modelVersion     String
  latencyMs        Int
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalCost        Float    @default(0.0)
  createdAt        DateTime @default(now())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────
// ENTERPRISE PLATFORM FOUNDATION (NFRs)
// ─────────────────────────────────────────────────────────────

model FeatureFlag {
  id          String   @id @default(uuid())
  companyId   String
  key         String
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  rules       Json     @default("[]") // e.g. [{ userType: 'ADMIN' }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
}

model TenantConfig {
  id              String    @id @default(uuid())
  companyId       String    @unique
  tier            String    @default("STANDARD") // STANDARD, ENTERPRISE
  apiRateLimit    Int       @default(1000) // reqs per minute
  maxUsers        Int       @default(10)
  maxVehicles     Int       @default(20)  // Truck/vehicle capacity limit
  maxDrivers      Int       @default(50)  // Driver capacity limit
  storageQuotaMb  Int       @default(5000)
  unlimitedMode   Boolean   @default(false) // Admin override — bypasses all capacity checks
  boostExpiresAt  DateTime? // Temporary capacity boost expiry timestamp
  boostMaxVehicles Int?     // Override vehicle limit during boost period
  brandingConfig  Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model PlatformMetric {
  id          String   @id @default(uuid())
  companyId   String
  category    String // API_LATENCY, WORKFLOW_DURATION, QUEUE_DEPTH
  metricName  String
  metricValue Float
  dimensions  Json     @default("{}")
  recordedAt  DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, category])
  @@index([recordedAt])
}

// ─────────────────────────────────────────────────────────────
// ENTERPRISE APP MARKETPLACE (V4.2)
// ─────────────────────────────────────────────────────────────

model MarketplaceApp {
  id              String   @id @default(uuid())
  name            String   @unique
  provider        String   @unique
  categoryId      String?
  developerId     String?
  description     String?
  status          String   @default("ACTIVE") // ACTIVE, DEPRECATED, IN_REVIEW
  websiteUrl      String?
  logoUrl         String?
  price           Float    @default(0.0)
  licenseType     String   @default("FREE") // FREE, FREEMIUM, PAID, ENTERPRISE
  supportedEvents Json     @default("[]")
  authType        String // OAUTH2, API_KEY
  isFirstParty    Boolean  @default(true)
  pluginType      String   @default("STANDARD") // STANDARD, INDUSTRY_PACK, AI_AGENT, UI_EXTENSION
  manifest        Json     @default("{}") // Declarative PluginManifest for extensibility
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category      MarketplaceCategory?  @relation(fields: [categoryId], references: [id])
  developer     MarketplaceDeveloper? @relation(fields: [developerId], references: [id])
  installations AppInstallation[]
  versions      MarketplaceVersion[]
  screenshots   AppScreenshot[]
  reviews       MarketplaceReview[]
  tags          AppTag[]
  permissions   AppPermission[]
  webhooks      MarketplaceWebhook[]

  @@index([developerId])
  @@index([categoryId])
}

model MarketplaceDeveloper {
  id           String           @id @default(uuid())
  name         String
  email        String?
  website      String?
  supportEmail String?
  isVerified   Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  apps         MarketplaceApp[]
}

model MarketplaceCategory {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  icon        String?
  apps        MarketplaceApp[]
}

model MarketplaceVersion {
  id            String         @id @default(uuid())
  appId         String
  version       String
  releaseNotes  String?
  isLatest      Boolean        @default(false)
  compatibility Json           @default("{}")
  createdAt     DateTime       @default(now())
  app           MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model MarketplaceReview {
  id        String         @id @default(uuid())
  appId     String
  userId    String?
  rating    Int
  comment   String?
  createdAt DateTime       @default(now())
  app       MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model AppScreenshot {
  id    String         @id @default(uuid())
  appId String
  url   String
  alt   String?
  order Int            @default(0)
  app   MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model AppTag {
  id    String         @id @default(uuid())
  appId String
  name  String
  app   MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model AppPermission {
  id          String         @id @default(uuid())
  appId       String
  scope       String // e.g., READ:LOADS, WRITE:TRIPS
  description String?
  isRequired  Boolean        @default(true)
  app         MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model AppInstallation {
  id           String    @id @default(uuid())
  companyId    String
  appId        String
  version      String?
  status       String    @default("ACTIVE") // PENDING, ACTIVE, SUSPENDED, UNINSTALLED
  healthStatus String    @default("INSTALLING") // RUNNING, INSTALLING, UPDATING, FAILED, DISABLED, WAITING_DEPENDENCY, UNHEALTHY
  credentials  Json // Should be encrypted references in a real system (KMS)
  settings     Json      @default("{}")
  runtimeState Json      @default("{}") // Isolated memory/state for the plugin
  installedBy  String? // UserId
  installedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSyncAt   DateTime?

  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  app            MarketplaceApp       @relation(fields: [appId], references: [id], onDelete: Cascade)
  gpsMappings    GpsVehicleMapping[]
  configurations AppConfiguration[]
  webhooks       AppWebhook[]
  oauthConns     AppOAuthConnection[]
  healths        AppHealth[]
  usageStats     AppUsageStatistic[]

  @@unique([companyId, appId])
  @@index([appId])
  @@index([companyId])
}

