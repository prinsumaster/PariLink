// -----------------------------------------
// Phase 3: Predictive Intelligence Engine
// -----------------------------------------

model IntelligencePrediction {
  id              String   @id @default(uuid())
  companyId       String
  entityId        String // vehicleId, tripId, etc.
  entityType      String
  predictionType  String // ETA, FUEL, MAINTENANCE
  predictedValue  Json
  confidenceScore Float
  featuresUsed    Json?
  createdAt       DateTime @default(now())

  @@index([companyId, entityType, entityId])
}

model IntelligencePredictionHistory {
  id              String   @id @default(uuid())
  companyId       String
  predictionId    String
  actualValue     Json?
  errorMargin     Float?
  feedbackApplied Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([companyId, predictionId])
}

model IntelligenceVehicleHealth {
  id                  String    @id @default(uuid())
  companyId           String
  vehicleId           String    @unique
  overallHealthScore  Float
  engineScore         Float
  brakeScore          Float
  tyreScore           Float
  batteryScore        Float
  predictedFailure    DateTime?
  remainingUsefulLife Int? // Days
  updatedAt           DateTime  @updatedAt

  @@index([companyId])
}

model IntelligenceRiskAssessment {
  id                  String   @id @default(uuid())
  companyId           String
  entityId            String
  entityType          String
  riskType            String // LATE_DELIVERY, BREAKDOWN, FATIGUE
  riskScore           Float
  severity            String // CRITICAL, HIGH, MEDIUM, LOW
  contributingFactors Json?
  createdAt           DateTime @default(now())

  @@index([companyId, entityType, entityId])
}

model IntelligenceRecommendation {
  id              String   @id @default(uuid())
  companyId       String
  contextType     String // DISPATCH, MAINTENANCE, ROUTING
  contextId       String
  suggestedAction Json
  predictedImpact Json?
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt       DateTime @default(now())

  @@index([companyId, contextType])
}

model IntelligenceModelMetrics {
  id            String   @id @default(uuid())
  companyId     String
  modelName     String
  accuracy      Float
  precision     Float
  recall        Float
  lastTrainedAt DateTime
  createdAt     DateTime @default(now())

  @@index([companyId, modelName])
}

model EmergencyAlert {
  id        String   @id @default(uuid())
  companyId String
  driverId  String
  tripId    String?
  type      String   @default("GENERAL") // ACCIDENT, BREAKDOWN, MEDICAL, HIJACK
  status    String   @default("ACTIVE") // ACTIVE, RESOLVED
  latitude  Float?
  longitude Float?
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id])
  trip      Trip?    @relation(fields: [tripId], references: [id])

  @@index([companyId, status])
  @@index([driverId])
}
