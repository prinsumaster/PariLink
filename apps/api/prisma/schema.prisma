  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  companyId String? // null = global template
  name      String
  eventType String // e.g. 'invoice.generated'
  channel   String // EMAIL, SMS, PUSH
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, eventType, channel])
  @@index([companyId])
}

model NotificationDelivery {
  id           String    @id @default(uuid())
  companyId    String
  userId       String?
  recipient    String // email or phone
  channel      String // EMAIL, SMS, PUSH
  eventType    String
  payload      Json?
  status       String    @default("PENDING") // PENDING, DELIVERED, FAILED
  providerId   String?
  errorMessage String?
  retryCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  sentAt       DateTime?

  @@index([companyId])
}

model Announcement {
  id           String    @id @default(uuid())
  companyId    String
  title        String
  content      String
  priority     String    @default("NORMAL")
  status       String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  scheduledFor DateTime?
  expiresAt    DateTime?
  requireAck   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  audiences AnnouncementAudience[]
  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model AnnouncementAudience {
  id             String   @id @default(uuid())
  announcementId String
  roleId         String? // null = all roles
  departmentId   String? // null = all departments
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

model InboxThread {
  id             String   @id @default(uuid())
  companyId      String
  subject        String?
  participantIds String[] // Array of user IDs
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages InboxMessage[]
  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users    User[]         @relation("InboxThreadUser")

  @@index([companyId])
}

model InboxMessage {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  content   String
  readBy    String[] // Array of user IDs who read it
  createdAt DateTime @default(now())

  thread InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User        @relation("InboxMessageSender", fields: [senderId], references: [id])

  @@index([threadId])
}

// ─────────────────────────────────────────────────────────────
// BUSINESS HEALTH ENGINE
// ─────────────────────────────────────────────────────────────

model BusinessHealthSnapshot {
  id                  String   @id @default(uuid())
  companyId           String
  operationalScore    Float // 0-100
  financialScore      Float // 0-100
  contributingFactors Json // Snapshot of variables used (e.g. utilization, margin, anomalies)
  timestamp           DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, timestamp])
}

// ─────────────────────────────────────────────────────────────
// LOGISTICS INTELLIGENCE NETWORK (LIN)
// ─────────────────────────────────────────────────────────────

model LinEventArchive {
  id                String   @id @default(uuid())
  eventType         String // e.g. "trip.completed", "anomaly.resolved"
  anonymizedPayload Json // Contains strictly stripped, non-PII, non-tenant data
  timestamp         DateTime @default(now())

  @@index([eventType, timestamp])
}

model LinBenchmark {
  id              String   @id @default(uuid())
  metricName      String   @unique // e.g. "fleet_utilization_avg"
  value           Float
  confidenceScore Float // 0-1 (e.g. 0.95 means high statistical significance)
  sampleSize      Int // Number of events that contributed to this metric
  updatedAt       DateTime @updatedAt
}

model IdentityProvider {
  id        String  @id @default(uuid())
  companyId String
  name      String // e.g., "Okta Production", "Azure AD"
  type      String // "OIDC", "SAML"
  status    String  @default("ACTIVE") // "ACTIVE", "INACTIVE"
  isDefault Boolean @default(false)

  // OIDC Specific
  issuer                String?
  clientId              String?
  clientSecret          String?
  authorizationEndpoint String?
  tokenEndpoint         String?
  userinfoEndpoint      String?
  jwksUri               String?

  // SAML Specific
  entryPoint       String?
  cert             String?
  issuerId         String?
  identifierFormat String? @default("urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress")
  authnContext     String?

  // Provisioning & Roles
  jitEnabled       Boolean @default(false)
  jitDefaultRoleId String?
  domainValidation String? // comma-separated domains allowed for JIT
  roleMapping      Json?   @default("{}") // e.g., {"okta_group_1": "role_id"}
  claimMapping     Json?   @default("{\"email\": \"email\", \"firstName\": \"given_name\", \"lastName\": \"family_name\"}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userIdentities UserIdentity[]
  ssoSessions    SsoSession[]

  @@index([companyId])
  @@index([companyId, deletedAt])
}

model UserIdentity {
  id                 String   @id @default(uuid())
  userId             String
  identityProviderId String
  providerUserId     String // The subject/NameID from the provider
  profileData        Json?    @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityProvider IdentityProvider @relation(fields: [identityProviderId], references: [id], onDelete: Cascade)

  @@unique([identityProviderId, providerUserId])
  @@index([userId])
  @@index([identityProviderId])
}

model SsoSession {
  id                 String    @id @default(uuid())
  identityProviderId String
  sessionId          String // Session index or ID from IdP
  userId             String
  createdAt          DateTime  @default(now())
  expiresAt          DateTime?

  identityProvider IdentityProvider @relation(fields: [identityProviderId], references: [id], onDelete: Cascade)

  @@unique([identityProviderId, sessionId])
  @@index([userId])
  @@index([identityProviderId])
}

model Department {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  code        String?
  description String?
  managerId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teams       Team[]
  users       User[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Team {
  id           String      @id @default(uuid())
  companyId    String
  departmentId String?
  name         String
  description  String?
  leadId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users        User[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([departmentId])
}

model CostCenter {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  budget    Float?   @default(0)
  currency  String?  @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users     User[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────
// ENTERPRISE OBSERVABILITY, RELIABILITY & OPERATIONS PLATFORM (V7.0)
// ─────────────────────────────────────────────────────────────

model SystemHealthLog {
  id           String   @id @default(uuid())
  companyId    String?
  component    String // API, DB, REDIS, QUEUE, WORKER, STORAGE, INTEGRATION, SERVICE
  status       String // HEALTHY, DEGRADED, UNHEALTHY, DOWN
  latencyMs    Int      @default(0)
  errorRatePct Float    @default(0)
  details      Json     @default("{}")
  recordedAt   DateTime @default(now())

  @@index([companyId, component, recordedAt])
  @@index([status, recordedAt])
}

model TraceSpan {
  id            String   @id @default(uuid())
  traceId       String
  spanId        String   @unique
  parentSpanId  String?
  companyId     String?
  serviceName   String
  operationName String
  startTime     DateTime
  endTime       DateTime
  durationMs    Int
  status        String   @default("OK") // OK, ERROR
  tags          Json     @default("{}")
  events        Json     @default("[]")
  createdAt     DateTime @default(now())

  @@index([traceId])
  @@index([companyId, serviceName, startTime])
  @@index([operationName, durationMs])
}

model EnterpriseLog {
  id             String   @id @default(uuid())
  companyId      String?
  level          String // INFO, WARN, ERROR, DEBUG, FATAL
  service        String
  message        String
  structuredData Json     @default("{}")
  correlationId  String?
  traceId        String?
  spanId         String?
  errorGroup     String?
  isRedacted     Boolean  @default(false)
  timestamp      DateTime @default(now())

  @@index([companyId, level, timestamp])
  @@index([correlationId])
  @@index([errorGroup, timestamp])
}

model AlertEscalationPolicy {
  id        String   @id @default(uuid())
  companyId String
  name      String
  severity  String   @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  steps     Json     @default("[]") // [{ delayMinutes: 5, targetRoles: ["ADMIN"], channels: ["EMAIL", "SMS"] }]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive])
}

model MaintenanceWindow {
  id               String   @id @default(uuid())
  companyId        String
  name             String
  description      String?
  startTime        DateTime
  endTime          DateTime
  affectedServices Json     @default("[]")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([companyId, startTime, endTime])
}

model Incident {
  id               String    @id @default(uuid())
  companyId        String
  title            String
  description      String
  severity         String    @default("SEV2") // SEV1, SEV2, SEV3, SEV4
  status           String    @default("INVESTIGATING") // INVESTIGATING, IDENTIFIED, MONITORING, RESOLVED, CLOSED
  assignedToId     String?
  rootCause        String?
  mitigationSteps  String?
  affectedServices Json      @default("[]")
  startedAt        DateTime  @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, status, severity])
  @@index([startedAt])
}

model IncidentTimelineEvent {
  id          String   @id @default(uuid())
  incidentId  String
  companyId   String
  eventType   String // STATUS_CHANGE, NOTE, ALERT_LINK, ACTION_TAKEN, MITIGATION
  description String
  metadata    Json     @default("{}")
  actorId     String?
  timestamp   DateTime @default(now())

  @@index([incidentId, timestamp])
  @@index([companyId])
}

model PostmortemReport {
  id                   String   @id @default(uuid())
  incidentId           String   @unique
  companyId            String
  title                String
  summary              String
  timelineSummary      Json     @default("[]")
  rootCauseAnalysis    String
  actionItems          Json     @default("[]")
  preventativeMeasures String?
  status               String   @default("DRAFT") // DRAFT, REVIEW, APPROVED, PUBLISHED
  authorId             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([companyId, status])
}

model BackupJob {
  id              String    @id @default(uuid())
  companyId       String
  backupType      String // DATABASE, STORAGE, CONFIGURATION, FULL_SYSTEM
  status          String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED, VERIFIED
  storageLocation String?
  sizeBytes       BigInt    @default(0)
  checksum        String?
  retentionDays   Int       @default(30)
  expiresAt       DateTime?
  errorDetails    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([companyId, backupType, status])
  @@index([expiresAt])
}

model DisasterRecoveryPlan {
  id                 String   @id @default(uuid())
  companyId          String
  name               String
  description        String?
  rtoTargetMinutes   Int      @default(60)
  rpoTargetMinutes   Int      @default(15)
  failoverProcedures Json     @default("[]")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId, isActive])
}

model DisasterRecoveryDrill {
  id               String    @id @default(uuid())
  planId           String
  companyId        String
  drillName        String
  status           String    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, SUCCESS, FAILED, PARTIAL
  actualRtoMinutes Int?
  actualRpoMinutes Int?
  findings         Json      @default("[]")
  conductedBy      String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([companyId, planId, status])
}

model PerformanceProfile {
  id                String   @id @default(uuid())
  companyId         String?
  profileType       String // SLOW_QUERY, CPU_SPIKE, MEMORY_LEAK, HIGH_LATENCY, CACHE_MISS_ANOMALY
  targetResource    String
  metricValue       Float
  thresholdValue    Float
  stackTraceOrQuery String?
  analysisDetails   Json     @default("{}")
  recordedAt        DateTime @default(now())

  @@index([companyId, profileType, recordedAt])
  @@index([targetResource, metricValue])
}

