// ============================================================================
// ENTERPRISE MASTER DATA MANAGEMENT (MDM)
// ============================================================================

model MasterRecord {
  id              String  @id @default(uuid())
  companyId       String
  entityType      String // "CUSTOMER", "VENDOR", "DRIVER", "VEHICLE", "WAREHOUSE", etc.
  globalId        String  @unique
  isGolden        Boolean @default(true)
  confidenceScore Float   @default(1.0)
  status          String  @default("ACTIVE") // ACTIVE, MERGED, ARCHIVED
  mergedIntoId    String?
  masterData      Json // The unified golden data payload

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  mergedInto MasterRecord?  @relation("MasterRecordMerge", fields: [mergedIntoId], references: [id])
  mergedFrom MasterRecord[] @relation("MasterRecordMerge")

  externalRefs  ExternalReference[]
  dataQuality   DataQualityScore?
  changeHistory MasterDataChangeLog[]

  // Backlinks to concrete modules (optional)
  customers  Customer[]
  vendors    Vendor[]
  drivers    Driver[]
  vehicles   Vehicle[]
  warehouses Warehouse[]

  @@index([companyId, entityType])
  @@index([companyId, deletedAt])
}

model ExternalReference {
  id             String   @id @default(uuid())
  masterRecordId String
  sourceSystem   String // "SAP", "LOCONAV", "SAMSARA", "LEGACY_ERP"
  externalId     String
  priority       Int      @default(0) // Higher priority systems override lower ones
  lastSyncedAt   DateTime @default(now())
  rawData        Json?

  masterRecord MasterRecord @relation(fields: [masterRecordId], references: [id], onDelete: Cascade)

  @@unique([masterRecordId, sourceSystem])
  @@index([sourceSystem, externalId])
  @@index([masterRecordId])
}

model DataQualityScore {
  id              String   @id @default(uuid())
  masterRecordId  String   @unique
  overallScore    Float // 0.0 to 100.0
  completeness    Float
  accuracy        Float
  uniqueness      Float
  consistency     Float
  lastEvaluatedAt DateTime @default(now())

  masterRecord MasterRecord @relation(fields: [masterRecordId], references: [id], onDelete: Cascade)

  @@index([masterRecordId])
}

model MasterDataChangeLog {
  id             String   @id @default(uuid())
  masterRecordId String
  userId         String?
  sourceSystem   String?
  action         String // "CREATE", "UPDATE", "MERGE", "SPLIT"
  changes        Json
  createdAt      DateTime @default(now())

  masterRecord MasterRecord @relation(fields: [masterRecordId], references: [id], onDelete: Cascade)

  @@index([masterRecordId])
}

model ReferenceData {
  id          String  @id @default(uuid())
  domain      String // "COUNTRY", "STATE", "VEHICLE_TYPE", "UOM", "CURRENCY"
  code        String
  name        String
  description String?
  attributes  Json?
  isActive    Boolean @default(true)
  version     Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([domain, code])
}

